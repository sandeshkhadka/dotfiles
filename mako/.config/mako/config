sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=15
icons=0
max-icon-size=64
default-timeout=3000
ignore-timeout=1
font=monospace 14

#rose pine
background-color=#26233a
border-color=#524f67
progress-color=over #31748f

[urgency=low]
border-color=#cccccc

[urgency=normal]
border-color=#d08770

[category=mpd]
default-timeout=2000
group-by=category

[urgency=high]
border-color=#eb6f92
default-timeout=0
